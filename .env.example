# ===========================================
# PrestaShop env
# ===========================================
BASE_URL=http://localhost:8080

# Back Office credentials (admin)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here

# Client data (for checkout)
CUSTOMER_EMAIL=your_customer_email_here
CUSTOMER_PASSWORD=your_customer_password_here

# ===========================================
# DB
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prestashop
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# ===========================================
# AI integration
# ===========================================
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ===========================================
# Playwright conf
# ===========================================
HEADLESS=true
SLOW_MO=0